# No -lstiles and no rpath: the glue loads libstiles itself at run time, one
# copy per live handle (dlopen / LoadLibrary, see sTiles_glue.c), so the
# package needs no libstiles present at *build* time.

# ifeq/+= are GNU make extensions, which a portable package may not use, so any
# platform decision happens in ./configure and is substituted into PKG_LIBS below.
PKG_LIBS = @PKG_LIBS@
