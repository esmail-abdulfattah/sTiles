#!/bin/sh
# Write src/Makevars.
#
# The glue references no libstiles symbol at link time: it loads each library
# copy itself (dlopen / LoadLibrary) and calls it through a function table, so
# there is no -lstiles, no rpath and no undefined symbol to allow on any
# platform.
PKG_LIBS=""

sed "s|@PKG_LIBS@|${PKG_LIBS}|" src/Makevars.in > src/Makevars
